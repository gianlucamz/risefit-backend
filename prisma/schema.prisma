generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Cargo {
  ALUNO
  PROFISSIONAL
  ADMIN
}

enum SubscriptionStatus {
  ATIVA
  CANCELADA
  EXPIRADA
  PENDENTE
}

enum OrderStatus {
  PENDENTE
  CONFIRMADO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum EventParticipantStatus {
  INSCRITO
  CANCELADO
  PRESENTE
  AUSENTE
}

enum ExerciseLevel {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

model User {
  id             Int   @id @default(autoincrement())
  nome           String   @db.VarChar(100)
  email          String   @unique @db.VarChar(150)
  senha          String   @db.VarChar(255)
  dataNascimento DateTime @map("data_nascimento") @db.Date
  telefone       String   @db.VarChar(20)
  cargo          Cargo    @default(ALUNO)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  profissional Professional?
  assinaturas  Subscription[]
  pedidos      Order[]
  eventos      EventParticipant[]

  @@index([cargo])
  @@map("usuarios")
}

model Professional {
  id             Int   @id @default(autoincrement())
  usuarioId      Int   @unique @map("usuarios_id")
  especializacao String   @db.VarChar(145)
  biografia      String?  @db.Text
  urlFoto        String?  @db.VarChar(255)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  usuario  User                  @relation(fields: [usuarioId], references: [id])
  servicos ProfessionalService[]

  @@map("profissionais")
}

model Service {
  id           Int   @id @default(autoincrement())
  nome         String   @db.VarChar(200)
  descricao    String?  @db.Text
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  profissionais ProfessionalService[]
  planos        PlanService[]

  @@map("servicos")
}

model ProfessionalService {
  profissionalId Int   @map("profissionais_id")
  servicoId      Int   @map("servicos_id")
  criadoEm       DateTime @default(now()) @map("criado_em")

  profissional Professional @relation(fields: [profissionalId], references: [id])
  servico      Service      @relation(fields: [servicoId], references: [id])

  @@id([profissionalId, servicoId])
  @@map("profissionais_servicos")
}

model Plan {
  id           Int   @id @default(autoincrement())
  nome         String   @db.VarChar(100)
  descricao    String?  @db.Text
  preco        Decimal  @db.Decimal(8, 2)
  duracaoMeses Int      @map("duracao_meses")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  assinaturas Subscription[]
  servicos    PlanService[]

  @@map("planos")
}

model PlanService {
  planoId   Int   @map("planos_id")
  servicoId Int   @map("servicos_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  plano   Plan    @relation(fields: [planoId], references: [id])
  servico Service @relation(fields: [servicoId], references: [id])

  @@id([planoId, servicoId])
  @@map("planos_servicos")
}

model Subscription {
  id           Int             @id @default(autoincrement())
  usuarioId    Int             @map("usuarios_id")
  planoId      Int             @map("planos_id")
  dataInicio   DateTime           @map("data_inicio") @db.Date
  dataFim      DateTime?          @map("data_fim") @db.Date
  status       SubscriptionStatus @default(PENDENTE)
  criadoEm     DateTime           @default(now()) @map("criado_em")
  atualizadoEm DateTime           @updatedAt @map("atualizado_em")

  usuario User @relation(fields: [usuarioId], references: [id])
  plano   Plan @relation(fields: [planoId], references: [id])

  @@index([usuarioId])
  @@index([planoId])
  @@index([status])
  @@map("assinaturas")
}

model Product {
  id           Int   @id @default(autoincrement())
  nome         String   @db.VarChar(150)
  descricao    String?  @db.Text
  preco        Decimal  @db.Decimal(9, 2)
  estoque      Int      @default(0)
  urlImagem    String?  @map("url_imagem") @db.VarChar(255)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  itensPedido OrderProduct[]

  @@index([ativo])
  @@map("produtos")
}

model Order {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuarios_id")
  total        Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDENTE)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  usuario User           @relation(fields: [usuarioId], references: [id])
  itens   OrderProduct[]

  @@index([usuarioId])
  @@index([status])
  @@map("pedidos")
}

model OrderProduct {
  id            Int  @id @default(autoincrement())
  pedidoId      Int  @map("pedidos_id")
  produtoId     Int  @map("produtos_id")
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)

  pedido  Order   @relation(fields: [pedidoId], references: [id])
  produto Product @relation(fields: [produtoId], references: [id])

  @@unique([pedidoId, produtoId])
  @@index([produtoId])
  @@map("pedidos_produtos")
}

model Event {
  id            Int   @id @default(autoincrement())
  titulo        String   @db.VarChar(200)
  descricao     String?  @db.Text
  local         String   @db.VarChar(200)
  horarioInicio DateTime @map("horario_inicio")
  horarioFim    DateTime @map("horario_fim")
  capacidade    Int
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  participantes EventParticipant[]

  @@map("eventos")
}

model EventParticipant {
  usuarioId    Int                 @map("usuarios_id")
  eventoId     Int                 @map("eventos_id")
  registradoEm DateTime               @default(now()) @map("registrado_em")
  status       EventParticipantStatus @default(INSCRITO)

  usuario User  @relation(fields: [usuarioId], references: [id])
  evento  Event @relation(fields: [eventoId], references: [id])

  @@id([usuarioId, eventoId])
  @@index([eventoId])
  @@index([status])
  @@map("participantes_eventos")
}

model Exercise {
  id            BigInt        @id @default(autoincrement())
  nome          String        @db.VarChar(150)
  grupoMuscular String        @map("grupo_muscular") @db.VarChar(100)
  descricao     String?       @db.Text
  passoAPasso   String        @map("passo_a_passo") @db.Text
  errosComuns   String?       @map("erros_comuns") @db.Text
  nivel         ExerciseLevel @default(INICIANTE)
  urlVideo      String?       @map("url_video") @db.VarChar(255)
  ativo         Boolean       @default(true)
  criadoEm      DateTime      @default(now()) @map("criado_em")
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em")

  @@index([grupoMuscular])
  @@index([nivel])
  @@map("exercicios")
}